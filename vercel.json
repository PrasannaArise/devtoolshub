{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://classicdevtools.pages.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://classicdevtools.pages.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; worker-src 'self'; connect-src 'none'; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
